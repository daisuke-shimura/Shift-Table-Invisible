<%= link_to "戻る", admin_weeks_path %>

<h1>admin Index</h1>
<div class="d-flex justify-content-between align-items-center">
  <h3><%= (@week.monday).day %>日～<%= (@week.sunday).day %>日のシフト希望</h3>
  <%= form_with url: visible_admin_week_path(@week.id), method: :patch, local: true do %>
    <div class="form-check form-switch">
      <%= check_box_tag "visible", true, @week.is_visible, class: "form-check-input", onchange: "this.form.submit();" %>
      <label class="form-check-label">表示切替</label>
    </div>
  <% end %>
</div>


<table class="table table-bordered table-hover">
  <thead>
    <tr class="table-secondary">
      <th></th>
      <th></th>
      <th class="<%= holiday_class(@week.monday) %>"><%= (@week.monday).month %>/<%= (@week.monday).day %></th>
      <th class="<%= holiday_class(@week.tuesday) %>"><%= (@week.tuesday).month %>/<%= (@week.tuesday).day %></th>
      <th class="<%= holiday_class(@week.wednesday) %>"><%= (@week.wednesday).month %>/<%= (@week.wednesday).day %></th>
      <th class="<%= holiday_class(@week.thursday) %>"><%= (@week.thursday).month %>/<%= (@week.thursday).day %></th>
      <th class="<%= holiday_class(@week.friday) %>"><%= (@week.friday).month %>/<%= (@week.friday).day %></th>
      <th class="<%= holiday_class(@week.saturday) || 'text-primary' %>"><%= (@week.saturday).month %>/<%= (@week.saturday).day %></th>
      <th class="text-danger"><%= (@week.sunday).month %>/<%= (@week.sunday).day %></th>
      <th></th>
      <th>備考</th>
    </tr>
    <tr class="table-secondary">
      <th></th>
      <th></th>
      <th class="<%= holiday_class(@week.monday) %>">月</th>
      <th class="<%= holiday_class(@week.tuesday) %> fw-bold">火</th>
      <th class="<%= holiday_class(@week.wednesday) %> fw-bold">水</th>
      <th class="<%= holiday_class(@week.thursday) %> fw-bold">木</th>
      <th class="<%= holiday_class(@week.friday) %> fw-bold">金</th>
      <th class="<%= holiday_class(@week.saturday) || 'text-primary' %> fw-bold">土</th>
      <th class="text-danger fw-bold">日</th>
      <th></th>
      <th></th>
    </tr>
  </thead>

  <tbody>
  <% if @week.is_visible %>
    <% @users.each do |user| %>
    <tr class="">
      <td><%= user.id %></td>
      <td><%= user.name %></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
    <% end %>
  <% else %>
    <tr>
      <td><%= current_user.id %></td>
      <td><%= current_user.name %></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
  <% end %>
  </tbody>
</table>
